rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fotos dos pets e carteirinhas
    match /registrations/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Comprovantes de vacina enviados por veterinários
    match /vaccines/{vetId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Fotos de perfil
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
